{
    // Run / debug easyEBL (F5). Select the .venv interpreter first (Python: Select Interpreter).
    // "easyEBL" uses the hardware configuration saved in the menu (Hardware → Configure…);
    // "easyEBL (simulators)" replaces every device by its simulator for that session.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "easyEBL",
            "type": "debugpy",
            "request": "launch",
            "module": "easyebl",
            "args": [],
            "justMyCode": true
        },
        {
            "name": "easyEBL (simulators)",
            "type": "debugpy",
            "request": "launch",
            "module": "easyebl",
            "args": ["--sim"],
            "justMyCode": true
        },
        {
            "name": "easyEBL (simulators, open SEM + EDS)",
            "type": "debugpy",
            "request": "launch",
            "module": "easyebl",
            "args": ["--sim", "--open", "sem,eds"],
            "justMyCode": true
        },
        {
            "name": "pytest (all)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
