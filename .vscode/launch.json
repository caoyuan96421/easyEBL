        },
        {
            "name": "SEM + EDS suite (USB-6363 + DP5)",
            "type": "debugpy",
            "request": "launch",
            "module": "easyebl.eds.gui.suite",
            "args": ["--backend", "nidaqmx", "--preset", "usb6363", "--device", "Dev1"],
